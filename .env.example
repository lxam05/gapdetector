# Required: application and database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gapdetector
JWT_SECRET_KEY=replace-with-a-long-random-value

# Required by application settings; placeholder values are enough for local
# email/password development because Google OAuth is not currently enabled.
GOOGLE_CLIENT_ID=local-placeholder
GOOGLE_CLIENT_SECRET=local-placeholder
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
EMAIL_FROM=dev@example.com

# Required for competitor analysis
SERPER_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Optional: email delivery (without these, email content is written to logs)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=true
MAILERSEND_API_KEY=
MAILERSEND_FROM_EMAIL=
MAILERSEND_TO_EMAIL=

# Optional: preview protection and distributed rate limiting
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=
REDIS_URL=
PREVIEW_IP_PER_DAY_LIMIT=2
PREVIEW_IP_PER_5M_LIMIT=1
PREVIEW_DOMAIN_REPEAT_BLOCK_SECONDS=600
PREVIEW_GLOBAL_DAILY_LIMIT=20
FULL_GLOBAL_DAILY_LIMIT=10
MAX_MONTHLY_API_CALLS=3000

# Optional: Stripe credits, one-off purchases and subscriptions
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
PRICE_SINGLE_REPORT=
PRICE_BUNDLE_5=
PRICE_SUB_MONTHLY=
SUCCESS_URL_BASE=http://localhost:8000

# Local browser access
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
